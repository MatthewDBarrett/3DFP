---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

const images = import.meta.glob('/src/assets/SampleRenders/*.{jpeg,jpg,png,gif,webp}');
---

<Layout title="3D Floor Plans | Engineer-Led Architectural Modeling">
    
    <nav class="fixed w-full z-50 top-0 bg-white/80 backdrop-blur-md border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <span class="text-lg md:text-xl font-bold tracking-tighter text-slate-800">
                3DFLOORPLANS<span class="text-blue-600">.COM.AU</span>
            </span>
    
            <button id="menu-toggle" class="md:hidden p-2 text-slate-600" aria-label="Toggle Menu">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
                </svg>
            </button>
    
            <div id="nav-links" class="hidden absolute top-16 left-0 w-full bg-white border-b border-slate-200 p-6 flex-col space-y-4 md:static md:flex md:flex-row md:items-center md:space-y-0 md:space-x-8 md:p-0 md:border-none md:bg-transparent md:w-auto">
                <a href="#showcase" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Showcase</a>
                <a href="#contact" class="bg-slate-900 text-white px-5 py-2 rounded-full text-sm font-medium text-center hover:bg-slate-800 transition-all">
                    Get a Quote
                </a>
            </div>
        </div>
    </nav>

    <main class="pt-32">
        <section class="max-w-7xl mx-auto px-6 text-center mb-24 text-slate-900">
            <h1 class="text-6xl md:text-7xl font-black tracking-tight mb-8">
                Complete precision.<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-500">Architectural clarity.</span>
            </h1>
            <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed">
                Transforming 2D blueprints into photorealistic 3D experiences. We provide architects and real estate agents with the visual edge needed to close deals faster.
            </p>
            <div class="flex flex-col md:flex-row justify-center gap-4">
                <a href="#showcase" class="px-8 py-4 bg-slate-900 text-white rounded-xl font-bold text-lg shadow-xl shadow-slate-200 hover:-translate-y-1 transition-all text-center">View Our Work</a>
                <a href="#contact" class="px-8 py-4 bg-white text-slate-900 border border-slate-200 rounded-xl font-bold text-lg hover:bg-slate-50 transition-all text-center">Request a Quote</a>
            </div>
        </section>

		<section class="bg-white border-y border-slate-200 py-12 mb-24">
			<div class="max-w-7xl mx-auto px-6 flex flex-wrap md:grid md:grid-cols-3 justify-center gap-8 text-center">
				<div>
					<p class="text-3xl font-bold text-slate-900">3-4 days</p>
					<p class="text-sm text-slate-500 uppercase tracking-widest mt-1">Typical Turnaround</p>
				</div>
				<div>
					<p class="text-3xl font-bold text-slate-900">100%</p>
					<p class="text-sm text-slate-500 uppercase tracking-widest mt-1">Scale Accuracy*</p>
				</div>
				<div>
					<p class="text-3xl font-bold text-slate-900">AU</p>
					<p class="text-sm text-slate-500 uppercase tracking-widest mt-1">Direct Support</p>
				</div>
			</div>
		</section>

        <section id="showcase" class="max-w-7xl mx-auto px-6 mb-32">
			<div class="mb-12 border-l-4 border-blue-600 pl-6">
				<h2 class="text-4xl font-black text-slate-900 tracking-tight uppercase">
					Project Showcase
				</h2>
				<p class="text-lg text-slate-500 mt-2">
					A gallery of our recent architectural visualizations and precision 3D floor plans.
				</p>
			</div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {Object.entries(images).map(([path, importImage], index) => (
                  <div 
                    class="relative group overflow-hidden rounded-2xl bg-slate-200 aspect-[16/10] shadow-lg cursor-zoom-in"
                    onclick={`window.openGallery(${index})`}
                  >
                    <Image 
                      src={importImage()} 
                      alt="Precision 3D Floor Plan Render" 
                      class="gallery-thumb object-cover w-full h-full transition-transform duration-700 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-slate-900/10 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="bg-white/90 text-slate-900 px-4 py-2 rounded-full text-sm font-bold shadow-xl">Expand View</span>
                    </div>
                  </div>
                ))}
            </div>
        </section>

        <div id="lightbox" class="fixed inset-0 z-[100] hidden backdrop-blur-md bg-white/10 flex items-center justify-center p-4 md:p-12 select-none" onclick="window.closeGallery()">
            <button class="absolute top-6 right-8 bg-slate-900/10 hover:bg-slate-900/20 text-slate-900 w-12 h-12 rounded-full flex items-center justify-center transition-all z-[110]" onclick="window.closeGallery()">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            
            <button class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 text-slate-900/30 hover:text-slate-900 text-4xl p-4 transition-all" onclick="event.stopPropagation(); window.changeImage(-1)">&#8592;</button>
            <button class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 text-slate-900/30 hover:text-slate-900 text-4xl p-4 transition-all" onclick="event.stopPropagation(); window.changeImage(1)">&#8594;</button>

            <div class="relative max-w-full max-h-full flex flex-col items-center justify-center" onclick="event.stopPropagation()">
                <img id="lightbox-img" src="" class="max-w-full max-h-[85vh] rounded-lg shadow-2xl transition-transform duration-300 scale-95 object-contain" />
                
                <div class="absolute bottom-6 left-6 pointer-events-none">
                    <span class="text-sm md:text-base font-bold tracking-tighter text-slate-800 bg-white/60 backdrop-blur-sm px-3 py-1 rounded-md">
                        3DFLOORPLANS<span class="text-blue-600">.COM.AU</span>
                    </span>
                </div>
            </div>
            
            <div id="gallery-counter" class="absolute bottom-8 text-slate-900/40 font-mono text-sm tracking-widest">01 / 00</div>
        </div>

		<section id="services-process" class="max-w-7xl mx-auto px-6 mb-32">
    
			<div class="mb-20">
				<div class="mb-12 border-l-4 border-blue-600 pl-6">
					<h2 class="text-4xl font-black text-slate-900 tracking-tight uppercase">Our Services</h2>
					<p class="text-lg text-slate-500 mt-2">Professional visualization for architecture and real estate.</p>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="bg-slate-50 p-8 rounded-3xl border border-slate-100 transition-all hover:shadow-xl hover:shadow-slate-200/50">
						<h3 class="text-xl font-bold text-slate-900 mb-4">2D to 3D Conversion</h3>
						<p class="text-slate-600 leading-relaxed text-sm">
							Our core service transforms existing floorplans into high quality 3D floor plans. Delivered as a crisp, top-down render, these models provide the spatial context 2D plans cannot match.
						</p>
					</div>
		
					<div class="bg-slate-50 p-8 rounded-3xl border border-slate-100 transition-all hover:shadow-xl hover:shadow-slate-200/50">
						<h3 class="text-xl font-bold text-slate-900 mb-4">Custom Renders</h3>
						<p class="text-slate-600 leading-relaxed text-sm">
							For more complicated or specific requirements, we offer bespoke modeling and site-specific textures. We can also provide the 3D model files for clients who wish to integrate them into their own internal pipelines.
						</p>
					</div>
		
					<div class="bg-blue-600 p-8 rounded-3xl text-white shadow-xl shadow-blue-100">
						<h3 class="text-xl font-bold mb-4">Complimentary Branding</h3>
						<p class="text-blue-50 leading-relaxed text-sm">
							Every project includes complimentary branding and theme integration. We match your agency's color palette and include your logo on the final outputs to ensure a seamless fit for your marketing materials.
						</p>
					</div>
				</div>
			</div>
		
			<div class="bg-slate-900 rounded-[3rem] p-10 md:p-16 text-white relative overflow-hidden">
				<div class="max-w-3xl mx-auto">
					<h2 class="text-3xl font-bold mb-4 text-center">The Precision Process</h2>
					
					<div class="space-y-12 relative">
						<div class="absolute left-[19px] top-2 bottom-2 w-px bg-slate-800"></div>
		
						<div class="relative pl-14">
							<div class="absolute left-0 top-1 w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-sm font-bold shadow-[0_0_20px_rgba(37,99,235,0.4)]">1</div>
							<h4 class="font-bold text-xl mb-1 text-white">Submit Your Floorplan</h4>
							<p class="text-slate-400 leading-relaxed">Upload your 2D floorplan via our quote request form. We accept PDF, PNG, and JPG formats.</p>
						</div>
		
						<div class="relative pl-14">
							<div class="absolute left-0 top-1 w-10 h-10 bg-slate-800 border border-slate-700 rounded-full flex items-center justify-center text-sm font-bold">3</div>
							<h4 class="font-bold text-xl mb-1 text-white">Initial Draft (3-4 Days)</h4>
							<p class="text-slate-400 leading-relaxed">We deliver a 3D draft within 3 to 4 business days. This allows you to visualize the spatial layout and provide initial feedback.</p>
						</div>
		
						<div class="relative pl-14">
							<div class="absolute left-0 top-1 w-10 h-10 bg-slate-800 border border-slate-700 rounded-full flex items-center justify-center text-sm font-bold">4</div>
							<h4 class="font-bold text-xl mb-1 text-white">Collaborative Revisions</h4>
							<p class="text-slate-400 leading-relaxed">We include up to 3 rounds of revisions as a standard part of our service.</p>
						</div>
		
						<div class="relative pl-14">
							<div class="absolute left-0 top-1 w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-sm font-bold">5</div>
							<h4 class="font-bold text-xl mb-1 text-white">Final Delivery</h4>
							<p class="text-slate-400 leading-relaxed">Upon approval, we deliver your 3D floor plan renders, fully branded and ready for use in your listings.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

        <section id="contact" class="max-w-4xl mx-auto px-6 mb-32 text-slate-900">
            <div class="bg-blue-600 rounded-[2rem] p-12 text-center text-white relative overflow-hidden">
                <div id="form-container">
                    <h2 class="text-4xl font-bold mb-4">Request a Quote</h2>
                    <form id="contact-form" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
                        <div class="md:col-span-1 space-y-2">
                            <label class="text-sm font-medium ml-1 text-white">Full Name</label>
                            <input type="text" name="name" required class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder:text-blue-200 focus:outline-none focus:bg-white/20" placeholder="John Citizen">
                        </div>
                        <div class="md:col-span-1 space-y-2">
                            <label class="text-sm font-medium ml-1 text-white">Email Address</label>
                            <input type="email" name="email" required class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder:text-blue-200 focus:outline-none focus:bg-white/20" placeholder="john@example.com">
                        </div>
                        <div class="md:col-span-2 space-y-2">
                            <label class="text-sm font-medium ml-1 text-white">Upload 2D floor plans or supporting documents (PDF, JPG, PNG)</label>
                            <input type="file" name="blueprint" accept=".pdf,.jpg,.jpeg,.png" required class="w-full px-4 py-3 rounded-xl bg-white/5 border border-dashed border-white/30 text-white text-sm cursor-pointer file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:bg-white file:text-blue-600" />
                        </div>
                        <div class="md:col-span-2 space-y-2">
                            <label class="text-sm font-medium ml-1 text-white">Project Details</label>
                            <textarea name="message" rows="4" class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder:text-blue-200 focus:outline-none focus:bg-white/20" placeholder="e.g. 2-bedroom apartment in Sydney..."></textarea>
                        </div>
                        <div id="form-status" class="md:col-span-2 hidden p-4 rounded-xl font-bold text-center text-sm"></div>
                        <button type="submit" id="submit-btn" class="md:col-span-2 mt-4 bg-white text-blue-600 py-4 rounded-xl font-bold text-lg hover:bg-blue-50 transition-all active:scale-95 shadow-lg">Request Quote</button>
                    </form>
                </div>
                <div id="success-container" class="hidden py-12">
                    <div class="w-20 h-20 bg-white/20 text-white rounded-full flex items-center justify-center mx-auto mb-6 text-3xl">✓</div>
                    <h2 class="text-4xl font-bold mb-4">Request Sent!</h2>
                    <button id="reset-btn" class="bg-white text-blue-600 px-8 py-3 rounded-xl font-bold hover:bg-blue-50 transition shadow-lg">Submit Another</button>
                </div>
            </div>
        </section>

		<section class="max-w-7xl mx-auto px-6 py-4">
			<div class="border-t border-slate-200 pt-4">
				<p class="text-xs text-slate-500 leading-relaxed">
					<span class="font-bold">*Technical Disclaimer:</span> 3D models are generated using engineer-validated coordinate snapping to ensure 1:1 scale fidelity. However, final spatial accuracy is strictly dependent on the precision and technical detail of the floor plans provided by the client.
				</p>
			</div>
		</section>
    </main>

    <footer class="bg-slate-900 text-slate-400 py-10 px-6 border-t border-slate-800">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-sm">
            <p>© 2026 3DFloorPlans.com.au. All rights reserved.</p>
            <div class="flex items-center gap-4">
                <span class="text-slate-600">100% Australian Owned</span>
                <p class="font-mono text-slate-500">ABN: 40 893 892 472</p>
            </div>
        </div>
    </footer>
</Layout>

<script is:inline>
    let currentIdx = 0;
    const allImages = Array.from(document.querySelectorAll('.gallery-thumb')).map(img => img.src);
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const counter = document.getElementById('gallery-counter');

    window.openGallery = (index) => {
        currentIdx = index;
        updateLightbox();
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        setTimeout(() => lightboxImg.classList.replace('scale-95', 'scale-100'), 10);
    };

    window.changeImage = (step) => {
        currentIdx = (currentIdx + step + allImages.length) % allImages.length;
        updateLightbox();
    };

    window.closeGallery = () => {
        lightboxImg.classList.replace('scale-100', 'scale-95');
        setTimeout(() => {
            lightbox.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }, 200);
    };

    function updateLightbox() {
        lightboxImg.src = allImages[currentIdx];
        counter.innerText = `${String(currentIdx + 1).padStart(2, '0')} / ${String(allImages.length).padStart(2, '0')}`;
    }

    document.addEventListener('keydown', (e) => {
        if (lightbox.classList.contains('hidden')) return;
        if (e.key === 'ArrowRight') window.changeImage(1);
        if (e.key === 'ArrowLeft') window.changeImage(-1);
        if (e.key === 'Escape') window.closeGallery();
    });

    const form = document.getElementById('contact-form');
    const btn = document.getElementById('submit-btn');
    const formContainer = document.getElementById('form-container');
    const successContainer = document.getElementById('success-container');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.innerText = "Processing...";
        const formData = new FormData(form);
        try {
            const response = await fetch('/api/contact', { method: 'POST', body: formData });
            if (response.ok) {
                formContainer.classList.add('hidden');
                successContainer.classList.remove('hidden');
                form.reset();
            }
        } catch (err) {
            btn.innerText = "Error. Try again?";
            btn.disabled = false;
        }
    });

    document.getElementById('reset-btn').onclick = () => {
        successContainer.classList.add('hidden');
        formContainer.classList.remove('hidden');
        btn.disabled = false;
        btn.innerText = "Request Quote";
    };
</script>